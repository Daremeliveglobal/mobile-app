    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "comment": "App Store purchases are iOS-only for now (see src/services/iapService.ts, which only loads expo-iap on iOS). Excluding expo-iap on Android keeps Google Play Billing and its BILLING permission out of the Android app until Android purchases are built.",
        "exclude": [
          "expo-iap"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-community/push-notification-ios",
          "react-native-chart-kit",
          "react-native-incall-manager",
          "@config-plugins/react-native-webrtc",
