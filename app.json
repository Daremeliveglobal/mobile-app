{
  "expo": {
    "name": "Daremelive",
    "slug": "daremelive-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "mobile",
      "com.googleusercontent.apps.158183037990-6lh53kvkqcak52djlbgh3dis8lekjso2"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "primaryColor": "#ffffff",
    "backgroundColor": "#ffffff",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mobile.daremelive",
      "buildNumber": "53",
      "icon": "./assets/images/icon.png",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "imageWidth": 200
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to camera for live streaming.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for live streaming audio.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to let you change your profile picture."
      },
      "bitcode": false
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "imageWidth": 200
      },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "package": "com.mobile.app",
      "versionCode": 53,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you change your profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to access your camera for live streaming.",
          "microphonePermission": "Allow this app to access your microphone for live streaming audio."
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "@stream-io/video-react-native-sdk",
        {
          "enableScreenshare": true,
          "appleTeamId": "VNFUB55J7S"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "flipper": false
          },
          "android": {}
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "GOOGLE_IOS_CLIENT_ID": "158183037990-6lh53kvkqcak52djlbgh3dis8lekjso2.apps.googleusercontent.com",
      "GOOGLE_ANDROID_CLIENT_ID": "",
      "GOOGLE_CLIENT_ID": "158183037990-2bou57ddq1nmlt8a57nsn6j5jj01qc51.apps.googleusercontent.com",
      "GOOGLE_EXPO_CLIENT_ID": "",
      "eas": {
        "projectId": "a9a7c332-ca39-426e-a998-2f473c1eb701",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "broadcast",
                  "bundleIdentifier": "com.mobile.daremelive.broadcast",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mobile.daremelive.appgroup"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "daremelive-limited"
  }
}
